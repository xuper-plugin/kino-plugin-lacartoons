{
  "id": "lacartoons",
  "name": "LA Cartoons Plus",
  "version": "0.4.10",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Dibujos animados clásicos doblados al español de lacartoons.com: por cadena (Nickelodeon, Cartoon Network, Disney…), con sección propia, categorías, temporadas y capítulos.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-lacartoons",
  "hosts": [
    "lacartoons.com",
    "www.lacartoons.com",
    "ok.ru",
    "cubeembed.rpmvid.com",
    "rpmvid.com"
  ],
  "fetchHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen"
  ],
  "streamHosts": "any",
  "categories": [
    "series"
  ],
  "color": "#F59E0B",
  "section": {
    "label": "Dibujos",
    "labelEn": "Cartoons"
  },
  "theme": {
    "accent": "#F59E0B",
    "onAccent": "#1A1203",
    "background": "#14110A",
    "surface": "#241D10",
    "highlight": "#FCD34D"
  },
  "settings": [
    {
      "key": "serverSection",
      "type": "section",
      "label": "Servidor",
      "labelEn": "Server",
      "hint": "Cada capítulo ofrece hasta dos reproductores; Kino abre el primero que funcione.",
      "hintEn": "Each episode offers up to two players; Kino opens the first that works."
    },
    {
      "key": "server",
      "type": "select",
      "label": "Servidor preferido",
      "labelEn": "Preferred server",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático",
          "labelEn": "Automatic"
        },
        {
          "value": "okru",
          "label": "ok.ru",
          "labelEn": "ok.ru"
        },
        {
          "value": "rpmvid",
          "label": "RPMVid",
          "labelEn": "RPMVid"
        }
      ]
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas?",
      "confirmEn": "Clear the list cache?"
    }
  ],
  "telemetry": true,
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "browser": true,
  "screen": {
    "label": "LA Cartoons Plus",
    "labelEn": "LA Cartoons Plus",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir LA Cartoons Plus",
      "labelEn": "Open LA Cartoons Plus"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?",
            "tmdb": "number?"
          },
          "out": "Item[]"
        },
        "episodes": {
          "in": {
            "ref": "string"
          },
          "out": "Episode[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        },
        "Episode": {
          "season": "number",
          "number": "number",
          "ref": "string",
          "title": "string?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "b1a6b8c3bb2c0fd8e7e975b8c357c62ceca39cc7e408b17ccb44f0df06f8b2b8d42c3a36790c7c67663c3afe3b51e8560eb06e4e1561cc3d09377b6649ddeb07"
  }
}
